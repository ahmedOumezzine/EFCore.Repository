@model EFCore.Repository.Demo.ViewModels.ProductListViewModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <form method="get" class="d-flex gap-2">
        <input name="search" value="@Model.Search" placeholder="Search by name, SKU, or description" class="form-control" />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>

<p class="text-muted">
    Page @Model.PageIndex of @Model.TotalPages (@Model.TotalItems products)
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>SKU</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Items)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Sku</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.Stock</td>
                <td>
                    <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">
                        @(product.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" href="/api/products/@product.Id">View API</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Product pages">
    <ul class="pagination">
        @for (var index = 1; index <= Model.TotalPages; index++)
        {
            <li class="page-item @(index == Model.PageIndex ? "active" : string.Empty)">
                <a class="page-link" href="?page=@index&search=@Model.Search">@index</a>
            </li>
        }
    </ul>
</nav>
